rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == 'adminlapangku@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // --- Users ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update, delete: if isOwner(userId) || isAdmin();
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Mitra ---
    match /mitra/{mitraId} {
      allow read: if true;
      allow create, update, delete: if isOwner(mitraId) || isAdmin();
    }
    
    // --- Lapangan ---
    match /lapangan/{lapanganId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) || isAdmin());
      
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
        
        // Izinkan Customer mengubah ulasannya, ATAU izinkan Mitra membalas ulasan
        allow update: if isAuthenticated() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) || 
          ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) || 
          ('mitraId' in get(/databases/$(database)/documents/lapangan/$(lapanganId)).data && get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.mitraId == request.auth.uid) ||
          ('MitraId' in get(/databases/$(database)/documents/lapangan/$(lapanganId)).data && get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.MitraId == request.auth.uid) ||
          ('id_pemilik' in get(/databases/$(database)/documents/lapangan/$(lapanganId)).data && get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.id_pemilik == request.auth.uid) ||
          isAdmin()
        );
        
        allow delete: if isAuthenticated() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin());
      }
    }
    
    // --- Bookings ---
    match /bookings/{bookingId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) || 
        ('idUser' in resource.data && resource.data.idUser == request.auth.uid) || 
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) ||
        ('MitraId' in resource.data && resource.data.MitraId == request.auth.uid) ||
        ('id_pemilik' in resource.data && resource.data.id_pemilik == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // --- Schedules ---
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) || isAdmin());
    }
    
    // --- Payouts ---
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin(); 
    }
    
    // --- Notifikasi ---
    match /notifikasi/{notificationId} {
      allow read: if isAuthenticated() && resource.data.customer_id == request.auth.uid;
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && (resource.data.customer_id == request.auth.uid || isAdmin());
    }

    // --- Metadata ---
    match /metadata/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
