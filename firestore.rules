rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNGSI BANTUAN (HELPER FUNCTIONS)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ==========================================
    // KOLEKSI: users (Customer / Admin)
    // ==========================================
    match /users/{userId} {
      // User bisa baca dan update profilnya sendiri
      allow read, update: if isOwner(userId);
      // Create diizinkan saat register
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Dilarang hard-delete dari client
      
      // Sub-koleksi favorites milik user
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ==========================================
    // KOLEKSI: mitra (Penyedia Lapangan)
    // ==========================================
    match /mitra/{mitraId} {
      // Siapapun yang login bisa melihat profil mitra (untuk UI lapangan)
      allow read: if isAuthenticated();
      // Mitra hanya bisa update profil mereka sendiri
      allow create, update: if isOwner(mitraId);
      allow delete: if false;
    }
    
    // ==========================================
    // KOLEKSI: lapangan
    // ==========================================
    match /lapangan/{lapanganId} {
      // Siapapun yang login bisa melihat lapangan
      allow read: if isAuthenticated();
      // Hanya mitra yang sesuai dengan mitraId di dalam field yang bisa create/update/delete
      allow create: if isAuthenticated() && request.resource.data.mitraId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.mitraId == request.auth.uid;
      
      // Sub-koleksi: reviews
      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        // Customer yang bisa membuat review untuk lapangan ini
        allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
      }
    }
    
    // ==========================================
    // KOLEKSI: bookings (Transaksi)
    // ==========================================
    match /bookings/{bookingId} {
      // Hanya customer yang membooking atau mitra yang memiliki lapangan yang bisa melihat
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.mitraId == request.auth.uid
      );
      
      // Customer yang membuat booking (pastikan customerId sesuai)
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      
      // Hanya customer atau mitra terkait yang bisa melakukan update (misal: ganti status, upload bayar)
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.mitraId == request.auth.uid
      );
      
      allow delete: if false; // Jangan izinkan delete booking, pakai sistem status 'cancelled'
    }
    
    // ==========================================
    // KOLEKSI: schedules (Jadwal operasional / block jadwal)
    // ==========================================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      // Hanya mitra yang bisa mengatur jadwal (asumsi dokumen schedule menyimpan mitraId)
      allow create: if isAuthenticated() && request.resource.data.mitraId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.mitraId == request.auth.uid;
    }
    
    // ==========================================
    // KOLEKSI: payouts (Penarikan Saldo Mitra)
    // ==========================================
    match /payouts/{payoutId} {
      // Hanya mitra terkait yang bisa melihat history payout miliknya
      allow read: if isAuthenticated() && resource.data.mitraId == request.auth.uid;
      // Mitra membuat request payout
      allow create: if isAuthenticated() && request.resource.data.mitraId == request.auth.uid;
      // Payout di-update/delete oleh Admin atau Cloud Functions (ditolak dari client)
      allow update, delete: if false; 
    }
    
    // ==========================================
    // KOLEKSI: notifikasi
    // ==========================================
    match /notifikasi/{notificationId} {
      // Hanya pemilik notifikasi yang bisa membaca, memperbarui (mark as read), atau menghapusnya
      allow read, update, delete: if isAuthenticated() && resource.data.customer_id == request.auth.uid;
    }
  }
}
