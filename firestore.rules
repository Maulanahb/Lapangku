rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNGSI BANTUAN (HELPER FUNCTIONS)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Cek admin via email token (cepat, tanpa Firestore read)
    // atau via field role di dokumen user (untuk admin yang dibuat lewat panel)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email == 'adminlapangku@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // ==========================================
    // KOLEKSI: users (Customer / Admin)
    // ==========================================
    match /users/{userId} {
      // User bisa baca dan update profilnya sendiri
      allow read, update: if isOwner(userId);
      // Create diizinkan saat register
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin(); // Admin diperbolehkan delete dari client
      
      // Sub-koleksi favorites milik user
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ==========================================
    // KOLEKSI: mitra (Penyedia Lapangan)
    // ==========================================
    match /mitra/{mitraId} {
      // Siapapun yang login bisa melihat profil mitra (untuk UI lapangan)
      allow read: if isAuthenticated();
      // Mitra hanya bisa update profil mereka sendiri
      allow create, update: if isOwner(mitraId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // KOLEKSI: lapangan
    // ==========================================
    match /lapangan/{lapanganId} {
      // Siapapun yang login bisa melihat lapangan
      allow read: if isAuthenticated();
      // Hanya mitra yang sesuai dengan mitraId di dalam field yang bisa create/update/delete
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      
      // Sub-koleksi: reviews
      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        // Customer yang bisa membuat review untuk lapangan ini
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // ==========================================
    // KOLEKSI: bookings (Transaksi)
    // ==========================================
    match /bookings/{bookingId} {
      // Siapapun yang login bisa membaca booking (untuk mengecek slot waktu yang sudah dipesan)
      allow read: if isAuthenticated();
      
      // Customer yang membuat booking (pastikan userId sesuai), atau Mitra (pastikan mitraId sesuai)
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.mitraId == request.auth.uid ||
        isAdmin()
      );
      
      // Hanya customer atau mitra terkait yang bisa melakukan update (misal: ganti status, upload bayar)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.mitraId == request.auth.uid ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // KOLEKSI: schedules (Jadwal operasional / block jadwal)
    // ==========================================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      // Hanya mitra yang bisa mengatur jadwal (asumsi dokumen schedule menyimpan mitraId)
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
    }
    
    // ==========================================
    // KOLEKSI: payouts (Penarikan Saldo Mitra)
    // ==========================================
    match /payouts/{payoutId} {
      // Hanya mitra terkait yang bisa melihat history payout miliknya
      allow read: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      // Mitra membuat request payout
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      // Payout di-update/delete oleh Admin
      allow update, delete: if isAdmin(); 
    }
    
    // ==========================================
    // KOLEKSI: notifikasi
    // ==========================================
    match /notifikasi/{notificationId} {
      // Hanya pemilik notifikasi yang bisa membaca, memperbarui (mark as read), atau menghapusnya
      allow read, update, delete: if isAuthenticated() && (resource.data.customer_id == request.auth.uid || isAdmin());
    }

    // ==========================================
    // KOLEKSI: metadata (Stats dll)
    // ==========================================
    match /metadata/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
