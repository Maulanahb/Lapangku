rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNGSI BANTUAN (HELPER FUNCTIONS)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Cek admin
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == 'adminlapangku@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // ==========================================
    // KOLEKSI: users (Customer / Admin)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
      
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ==========================================
    // KOLEKSI: mitra (Penyedia Lapangan)
    // ==========================================
    match /mitra/{mitraId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(mitraId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // KOLEKSI: lapangan
    // ==========================================
    match /lapangan/{lapanganId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('mitraId' in request.resource.data && request.resource.data.mitraId == request.auth.uid) ||
        ('MitraId' in request.resource.data && request.resource.data.MitraId == request.auth.uid) ||
        ('id_pemilik' in request.resource.data && request.resource.data.id_pemilik == request.auth.uid) ||
        isAdmin()
      );
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) ||
        ('MitraId' in resource.data && resource.data.MitraId == request.auth.uid) ||
        ('id_pemilik' in resource.data && resource.data.id_pemilik == request.auth.uid) ||
        isAdmin()
      );
      
      match /reviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/lapangan/$(lapanganId)) && (
            get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.mitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.MitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(lapanganId)).data.id_pemilik == request.auth.uid
          )) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) || 
          isAdmin()
        );
      }
    }
    
    // ==========================================
    // KOLEKSI: bookings (Transaksi)
    // ==========================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.mitraId == request.auth.uid ||
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) || 
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) ||
        ('MitraId' in resource.data && resource.data.MitraId == request.auth.uid) ||
        ('id_pemilik' in resource.data && resource.data.id_pemilik == request.auth.uid) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // KOLEKSI: schedules (Jadwal operasional / block jadwal)
    // ==========================================
    // KOLEKSI: schedules (Jadwal operasional / block jadwal)
    // ==========================================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('fieldId' in request.resource.data && 
          exists(/databases/$(database)/documents/lapangan/$(request.resource.data.fieldId)) && (
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.fieldId)).data.mitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.fieldId)).data.MitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.fieldId)).data.id_pemilik == request.auth.uid
          )
        ) ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        ('fieldId' in resource.data && 
          exists(/databases/$(database)/documents/lapangan/$(resource.data.fieldId)) && (
            get(/databases/$(database)/documents/lapangan/$(resource.data.fieldId)).data.mitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(resource.data.fieldId)).data.MitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(resource.data.fieldId)).data.id_pemilik == request.auth.uid
          )
        ) ||
        isAdmin()
      );
    }
    
    // --- Jadwal ---
    match /jadwal/{jadwalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('lapangan_id' in request.resource.data && 
          exists(/databases/$(database)/documents/lapangan/$(request.resource.data.lapangan_id)) && (
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.lapangan_id)).data.mitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.lapangan_id)).data.MitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(request.resource.data.lapangan_id)).data.id_pemilik == request.auth.uid
          )
        ) ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        ('lapangan_id' in resource.data && 
          exists(/databases/$(database)/documents/lapangan/$(resource.data.lapangan_id)) && (
            get(/databases/$(database)/documents/lapangan/$(resource.data.lapangan_id)).data.mitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(resource.data.lapangan_id)).data.MitraId == request.auth.uid ||
            get(/databases/$(database)/documents/lapangan/$(resource.data.lapangan_id)).data.id_pemilik == request.auth.uid
          )
        ) ||
        isAdmin()
      );
    }
    
    // ==========================================
    // KOLEKSI: payouts (Penarikan Saldo Mitra)
    // ==========================================
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin(); 
    }
    
    // --- Mitra Devices ---
    match /mitra_devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) || 
        isAdmin()
      );
    }
    
    // --- Mitra Security Logs ---
    match /mitra_security_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.mitraId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.mitraId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // --- Notifikasi ---
    match /notifikasi/{notificationId} {
      allow read: if isAuthenticated() && (
        ('customer_id' in resource.data && resource.data.customer_id == request.auth.uid) ||
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) ||
        ('mitra_id' in resource.data && resource.data.mitra_id == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && (
        ('customer_id' in resource.data && resource.data.customer_id == request.auth.uid) ||
        ('mitraId' in resource.data && resource.data.mitraId == request.auth.uid) ||
        ('mitra_id' in resource.data && resource.data.mitra_id == request.auth.uid) ||
        isAdmin()
      );
    }

    // ==========================================
    // KOLEKSI GROUP: reviews (Ulasan untuk collection group queries)
    // ==========================================
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAuthenticated();
    }

    // ==========================================
    // KOLEKSI: metadata (Stats dll)
    // ==========================================
    match /metadata/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
